# --- ntfy (required) ---
# Public instance: https://ntfy.sh   Self-hosted: https://ntfy.example.com
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=change-me-to-a-private-topic-name
# Only needed for self-hosted instances with auth enabled, or protected ntfy.sh topics.
NTFY_TOKEN=
# true (default): send a notification every run, even when everything is fine
#                  (dead-man's-switch style, so you know the checker is alive).
# false: only notify on warning/critical.
NTFY_NOTIFY_ON_OK=true

# --- Where the auth persistence volume lives on the host (docker-compose.yml) ---
CODEX_AUTH_DIR=~/.codex

# --- Scheduling ---
# Standard 5-field cron expression, evaluated inside the container (UTC unless
# you also set TZ below). Default: hourly.
CRON_SCHEDULE=0 * * * *
# Optional: set a real timezone (e.g. Europe/Stockholm) so CRON_SCHEDULE and
# notification timestamps read in local time instead of UTC.
# TZ=

# --- Checks ---
# Speedtest is heavy (uses real bandwidth) and runs on its own cadence,
# independent of CRON_SCHEDULE, tracked in ./data/state.json.
SPEEDTEST_INTERVAL_HOURS=24
# Optional: flag the speed test as a warning if measured throughput drops
# below half of these. Leave unset to just report the numbers, unjudged.
EXPECTED_DOWNLOAD_MBPS=
EXPECTED_UPLOAD_MBPS=
# Comma-separated host:port list to watch for TLS certificate expiry. Empty = skipped.
CERT_HOSTS=
# Cap on how many recent error/warning log lines are fed to the AI per run.
LOG_LINES_MAX=200

# --- Deterministic fallback thresholds ---
# Used both as a safety-net status if the Codex call fails, and to size the
# raw data handed to the AI. Percent values.
CPU_WARN_PCT=80
CPU_CRIT_PCT=95
MEM_WARN_PCT=85
MEM_CRIT_PCT=95
DISK_WARN_PCT=80
DISK_CRIT_PCT=95

# --- Codex ---
# How long to wait for `codex exec` before falling back to the deterministic report.
CODEX_TIMEOUT_SECONDS=120
